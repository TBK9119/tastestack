// TasteStack database schema
// Provider: sqlite (local dev). When going live (Phase B),
// swap `provider = "sqlite"` → `"postgresql"` and set DATABASE_URL to Supabase.
// The model definitions stay identical — no migration work needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Users ----------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  username     String   @unique // url handle, e.g. "thava" -> /@thava
  displayName  String
  bio          String   @default("")
  avatarUrl    String   @default("")
  bannerColor  String   @default("#2e51a2")
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items       Item[]
  activities  Activity[]
  followers   Follow[]  @relation("Following")
  following   Follow[]  @relation("Follower")
  sessions    Session[]
  accounts    Account[]

  @@map("users")
}

// ---------- Media items (anime, movies, games, etc.) ----------
model Item {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "anime" | "manga" | "movie" | "tv" | "game" | "album" | "book"
  type            String
  // ID from the source API (e.g. AniList media id, TMDB movie id)
  apiId           String
  // "anilist" | "tmdb" | "rawg" | "lastfm" | "openlibrary"
  source          String
  title           String
  coverUrl        String   @default("")
  year            String   @default("")
  // extra metadata as JSON: genres, runtime, artist, author, etc.
  extra           String   @default("{}")
  // "watching" | "completed" | "planned" | "dropped" | "onhold"
  status          String   @default("planned")
  rating          Int      @default(0) // 0 = unrated, 1-10 otherwise
  progressCurrent Int      @default(0)
  progressTotal   Int      @default(0)
  review          String   @default("")
  isFavorite      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activities Activity[]

  @@unique([userId, type, apiId, source]) // can't add the same item twice
  @@index([userId, type, status])
  @@map("items")
}

// ---------- Social: follow graph ----------
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId]) // can't follow the same person twice
  @@index([followingId])
  @@map("follows")
}

// ---------- Activity feed ----------
model Activity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String?
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  // "added" | "rated" | "completed" | "favorited" | "reviewed"
  action    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("activities")
}

// ---------- NextAuth required tables ----------
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
